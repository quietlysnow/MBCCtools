# MFAAvalonia 运行时：由 UI 自身升级/覆盖，不是本项目源码
/MFAAvalonia.exe
/MFAAvalonia.dll
/MFAAvalonia.deps.json
/MFAAvalonia.runtimeconfig.json
/MaaPiCli.exe
/MaaNode.node
/MaaNodeServer.node
/libloader.dll
/libs/
/runtimes/
/plugins/

# 本机状态与运行产物
/appsettings.json
/config/
/logs/
/debug/
/temp/
/backup/
/assets/
/record/
/.nicegui/

# 构建与依赖下载：install.py / CI 的目录布局，本地复现打包时会出现
/deps/
/install/
/MFA/
# agent 的便携解释器只进发布包（打包时生成），不进源码树
/agent/python/

# 工具缓存与本地 AI 助手文件
/.qoder-credits/
/.scratch/
/.workbuddy/
/.claude/
/.zcodeignore
/node_modules/
__pycache__/
*.pyc

# 编辑器与系统（.vscode 只共享这两个文件，其余本机配置不放进来）
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
/.idea/
.DS_Store
Thumbs.db

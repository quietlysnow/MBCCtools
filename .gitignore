# MFAAvalonia 运行时：由 UI 自身升级/覆盖，不是本项目源码
/MFAAvalonia.exe
/MFAAvalonia.dll
/MFAAvalonia.deps.json
/MFAAvalonia.runtimeconfig.json
/MaaPiCli.exe
/MaaNode.node
/MaaNodeServer.node
/libloader.dll
/libs/
/runtimes/
/plugins/
# 部署脚本顺带拷进来的冗余副本，真正的在 libs/MaaAgentBinary/，程序启动时会自行删掉它
/MaaAgentBinary/

# 本机状态与运行产物
/appsettings.json
/config/
/logs/
/debug/
/temp/
/backup/
/assets/
/record/
/.nicegui/
# MFAAvalonia 生成的界面布局状态：GUI 首次启动按 TaskQueueView.axaml 的默认栅格重建。
# 归 MFA 工作区（UI），本仓库不再跟踪
/resource/mfa_layout.json

# 构建与依赖下载：install.py / CI 的目录布局，本地复现打包时会出现
/deps/
/install/
/MFA/
# agent 的便携解释器只进发布包（打包时生成），不进源码树
/agent/python/

# 本机离线查阅的 MaaFramework 文档副本，不入库；在线版以 https://maafw.com/docs 为准
/docs/

# 工具缓存与本地 AI 助手文件
/.qoder-credits/
/.scratch/
/.workbuddy/
/.claude/
/.zcode/
/.commandcode/
/.zcodeignore
/node_modules/
__pycache__/
*.pyc

# 编辑器与系统（.vscode 只共享这两个文件，其余本机配置不放进来）
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
/.idea/
.DS_Store
Thumbs.db

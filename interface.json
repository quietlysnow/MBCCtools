                  "危",
                  "普"
                ],
                "gate_roi": [
                  414,
                  218,
                  425,
                  60
                ],
                "page_roi": [
                  735,
                  625,
                  65,
                  36
                ],
                "max_pages": 200,
                "stop_on_known": true
              }
            }
          }
        }
      ],
      "description": "- **完整识别**：从第 1 页翻完整份列表，逐行去重、只补没见过的记录；不会漏页，较慢\n- **识别到已知停止**：撞见已入库的记录就停；快，适合刚抽完卡补记录"
    },

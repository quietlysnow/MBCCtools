{
  "interface_version": 2,
  "name": "MBCCtools",
  "title": "MBCCtools",
  "icon": "resource/base/image/logo.ico",
  "version": "v1.5.2",
  "mirrorchyan_rid": "MBCCtools",
  "mirrorchyan_multiplatform": true,
  "url": "https://github.com/quietlysnow/MBCCtools",
  "controller": [
    {
      "name": "安卓端",
      "type": "Adb"
    }
  ],
  "agent": {
    "child_exec": "python",
    "child_args": [
      "./agent/main.py"
    ],
    "identifier": "MBCCtools"
  },
  "resource": [
    {
      "name": "官服",
      "path": [
        "{PROJECT_DIR}/resource/base"
      ]
    },
    {
      "name": "B服",
      "path": [
        "{PROJECT_DIR}/resource/base",
        "{PROJECT_DIR}/resource/bilibili"
      ]
    },
    {
      "name": "国际服",
      "path": [
        "{PROJECT_DIR}/resource/base",
        "{PROJECT_DIR}/resource/global"
      ]
    }
  ],
  "task": [
    {
      "name": "进入游戏",
      "entry": "启动",
      "doc": "[color:orange]请注意[/color]\n有可能失败，建议手动进入主菜单后再运行"
    },
    {
      "name": "助手待办（官服试验）",
      "resource": [
        "官服"
      ],
      "entry": "助手待办",
      "option": [
        "助手体力处理",
        "畸点选择",
        "派遣区域",
        "作战区域",
        "材料选择",
        "关卡未开放备选"
      ],
      "pipeline_override": {
        "收集派遣奖励": {
          "max_hit": 1
        },
        "发出派遣": {
          "max_hit": 1
        },
        "派遣区域选择": {
          "max_hit": 1
        }
      },
      "doc": "[color:orange]仅官服的试验功能[/color]\n请从游戏主页运行，按夜莺助手列出的已适配待办处理事务。未知或执行失败的条目保留，运行结束后请核对剩余待办。\n默认[b]保留体力[/b]；选择[b]按配置清理体力[/b]后，会使用下方作战区域、材料与备选关卡配置消耗现有体力，不购买体力。"
    },
    {
      "name": "秘盟捐赠",
      "entry": "密盟",
      "doc": "默认捐赠[b]狄斯币[/b]"
    },
    {
      "name": "秘盟兑换",
      "entry": "密盟兑换",
      "option": [
        "兑换档位",
        "兑换物资"
      ],
      "doc": "自动从[b]主菜单[/b]进入采购办 → 玩法兑换 → 秘盟兑换；已经停在兑换页（停在哪个档位都行）也能直接运行\n\n[b]兑换档位[/b]决定换哪几档（默认三档全换），[b]兑换物资[/b]决定换哪些物资，每种按[b]本月限购[/b]一次买满\n\n两处都不勾则不会兑换任何东西"
    },
    {
      "name": "好友点数",
      "entry": "友情点"
    },
    {
      "name": "监管奖励",
      "entry": "监管"
    },
    {
      "name": "采购办免费礼包",
      "entry": "采购办"
    },
    {
      "name": "一键派遣",
      "entry": "派遣",
      "option": [
        "派遣区域"
      ],
      "doc": "[color:orange]不会[/color]帮你领取声望奖励哦"
    },
    {
      "name": "领取体力",
      "entry": "体力"
    },
    {
      "name": "邮箱领取",
      "entry": "邮箱"
    },
    {
      "name": "扫荡浊暗之阱",
      "entry": "浊暗之阱",
      "doc": "默认扫荡[b]乐园幻境[/b]"
    },
    {
      "name": "扫荡记忆风暴",
      "entry": "记忆风暴",
      "option": [
        "畸点选择"
      ],
      "doc": "本任务会自动扫荡正在开放的畸点最高难度三次"
    },
    {
      "name": "每日体力用途",
      "entry": "每日体力用途",
      "option": [
        "作战区域",
        "材料选择",
        "关卡未开放备选"
      ],
      "doc": "\n选择[b]「刷取材料」[/b]时需要同时选择材料\n\n选择[b]「关卡未开放备选」[/b]后，当日关卡未开放时会自动刷取备选关卡"
    },
    {
      "name": "每日/密令奖励",
      "entry": "密令"
    },
    {
      "name": "破碎防线",
      "entry": "破碎防线",
      "doc": "只支持自动领奖，不战斗"
    },
    {
      "name": "抽卡记录",
      "entry": "抽卡记录",
      "option": [
        "识别方式"
      ],
      "doc": "**使用前**\n\n- 先在模拟器里手动打开游戏内的抽卡记录页（当前显示哪个卡池就采哪个）\n- 采完自动结束；要采其它卡池，在游戏里切过去再跑一次\n- 「识别方式」在下方选项里切换\n\n> 有疑问可查看「设置」→「关于我们」→「显示公告」"
    }
  ],
  "option": {
    "助手体力处理": {
      "default_case": "保留体力",
      "cases": [
        {
          "name": "保留体力",
          "pipeline_override": {
            "助手待办清体力": {
              "enabled": false
            }
          }
        },
        {
          "name": "按配置清理体力",
          "pipeline_override": {
            "助手待办清体力": {
              "enabled": true
            }
          }
        }
      ],
      "description": "先处理助手中的免费事务，再按所选配置清理现有体力。默认保留体力，不购买体力。"
    },

    "识别方式": {
      "cases": [
        {
          "name": "完整识别",
          "pipeline_override": {
            "抽卡记录_单页识别": {
              "custom_recognition_param": {
                "archive": "record/抽卡记录",
                "min_score": 0.5,
                "line_tol": 14,
                "badge_x": [
                  856,
                  908
                ],
                "rarity_dir": "抽卡",
                "rarity_tiers": [
                  "狂",
                  "危",
                  "普"
                ],
                "gate_roi": [
                  414,
                  218,
                  425,
                  60
                ],
                "page_roi": [
                  735,
                  625,
                  65,
                  36
                ],
                "max_pages": 200
              }
            }
          }
        },
        {
          "name": "识别到已知停止",
          "pipeline_override": {
            "抽卡记录_单页识别": {
              "custom_recognition_param": {
                "archive": "record/抽卡记录",
                "min_score": 0.5,
                "line_tol": 14,
                "badge_x": [
                  856,
                  908
                ],
                "rarity_dir": "抽卡",
                "rarity_tiers": [

{
  "interface_version": 2,
  "name": "MBCCtools",
  "title": "MBCCtools",
  "icon": "resource/base/image/logo.ico",
  "version": "v1.5.1",
  "mirrorchyan_rid": "MBCCtools",
  "mirrorchyan_multiplatform": true,
  "url": "https://github.com/quietlysnow/MBCCtools",
  "controller": [
    {
      "name": "安卓端",
      "type": "Adb"
    }
  ],
  "agent": {
    "child_exec": "python",
    "child_args": [
      "./agent/main.py"
    ],
    "identifier": "MBCCtools"
  },
  "resource": [
    {
      "name": "官服",
      "path": [
        "{PROJECT_DIR}/resource/base"
      ]
    },
    {
      "name": "B服",
      "path": [
        "{PROJECT_DIR}/resource/base",
        "{PROJECT_DIR}/resource/bilibili"
      ]
    },
    {
      "name": "国际服",
      "path": [
        "{PROJECT_DIR}/resource/base",
        "{PROJECT_DIR}/resource/global"
      ]
    }
  ],
  "task": [
    {
      "name": "进入游戏",
      "entry": "启动",
      "doc": "[color:orange]请注意[/color]\n有可能失败，建议手动进入主菜单后再运行"
    },
    {
      "name": "秘盟捐赠",
      "entry": "密盟",
      "doc": "默认捐赠[b]狄斯币[/b]"
    },
    {
      "name": "好友点数",
      "entry": "友情点"
    },
    {
      "name": "监管奖励",
      "entry": "监管"
    },
    {
      "name": "采购办免费礼包",
      "entry": "采购办"
    },
    {
      "name": "一键派遣",
      "entry": "派遣",
      "option": [
        "派遣区域"
      ],
      "doc": "[color:orange]不会[/color]帮你领取声望奖励哦"
    },
    {
      "name": "领取体力",
      "entry": "体力"
    },
    {
      "name": "邮箱领取",
      "entry": "邮箱"
    },
    {
      "name": "扫荡浊暗之阱",
      "entry": "浊暗之阱",
      "doc": "默认扫荡[b]乐园幻境[/b]"
    },
    {
      "name": "扫荡记忆风暴",
      "entry": "记忆风暴",
      "option": [
        "畸点选择"
      ],
      "doc": "本任务会自动扫荡正在开放的畸点最高难度三次"
    },
    {
      "name": "每日体力用途",
      "entry": "每日体力用途",
      "option": [
        "作战区域",
        "材料选择",
        "关卡未开放备选"
      ],
      "doc": "\n选择[b]「刷取材料」[/b]时需要同时选择材料\n\n选择[b]「关卡未开放备选」[/b]后，当日关卡未开放时会自动刷取备选关卡"
    },
    {
      "name": "每日/密令奖励",
      "entry": "密令"
    },
    {
      "name": "破碎防线",
      "entry": "破碎防线",
      "doc": "只支持自动领奖，不战斗"
    },
    {
      "name": "抽卡记录",
      "entry": "抽卡记录",
      "option": [
        "识别方式"
      ],
      "doc": "**使用前**\n\n- 先在模拟器里手动打开游戏内的抽卡记录页（当前显示哪个卡池就采哪个）\n- 采完自动结束；要采其它卡池，在游戏里切过去再跑一次\n- 「识别方式」在下方选项里切换\n\n> 有疑问可查看「设置」→「关于我们」→「显示公告」"
    }
  ],
  "option": {
    "作战区域": {
      "cases": [

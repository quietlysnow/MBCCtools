        {
          "name": "狄斯币",
          "icon": "image/材料/狄斯币.png",
          "pipeline_override": {
            "职业选择": {
              "on_error": [
                "狄斯币"
              ]
            }
          }
        },
        {
          "name": "狂厄精粹",
          "icon": "image/材料/狂厄精粹.png",
          "pipeline_override": {
            "职业选择": {
